# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Dev-time only: used by `npm run gen` to generate art. Not needed at runtime.
AZURE_IMAGE_GENERATIONS_URL=https://<resource>.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2024-02-01
AZURE_IMAGE_KEY=your-azure-image-key
