    "start": "node server/index.mjs",
    "gen": "node --env-file=.env tools/gen-assets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "sharp": "^0.33.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
